# --- Project
PROJECT_NAME=wp-local
HOST_HTTP_PORT=8080
PHPMYADMIN_PORT=8081

# --- WP Settings
WP_SITEURL=http://localhost:8080
WP_TABLE_PREFIX=wp_

# --- Git (private repo)
GIT_REMOTE=git@gitlab.com:your-namespace/your-repo.git
# or use HTTPS with token:
# GIT_REMOTE=https://oauth2:${GITLAB_TOKEN}@gitlab.com/your-namespace/your-repo.git
GITLAB_TOKEN=

# --- MySQL
MYSQL_DATABASE=wordpress
MYSQL_USER=wp
MYSQL_PASSWORD=wp
MYSQL_ROOT_PASSWORD=change-me

# --- WP (matches your local files in repo root)
WP_DOCROOT=/var/www/html

# --- Dump (public URL to a .tar.gz that contains a single .sql)
MYSQL_DUMP_URL=https://example.com/path/to/dump.tar.gz
