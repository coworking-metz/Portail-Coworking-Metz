#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export COMPOSE_FILE=./docker-compose.yml
cp -n .env.example .env 2>/dev/null || true
docker compose up -d --build
echo "→ http://localhost:$(grep -E '^HOST_HTTP_PORT=' .env | cut -d= -f2)"
echo "→ phpMyAdmin: http://localhost:$(grep -E '^PHPMYADMIN_PORT=' .env | cut -d= -f2)"
